CHML_DATA_BASE_URL=https://chml-history.netlify.app
CHML_SITE_URL=https://chml-history.netlify.app/#/
CHML_REFRESH_MINUTES=30
# Run npm run groups to find the exact ID. Comma-separate multiple allowed groups.
WHATSAPP_GROUP_JIDS=
# Legacy singular setting is also supported when the plural is empty.
WHATSAPP_GROUP_JID=
WHATSAPP_AUTH_DIR=./auth/whatsapp
WHATSAPP_ALLOW_SELF=false
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
# Optional legacy HTTP server settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8787
BOT_SHARED_SECRET=change-me
